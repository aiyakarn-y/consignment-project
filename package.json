{
  "name": "consignment-system",
  "version": "0.3.0-beta.1",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "build": "npm --prefix frontend run build",
    "start": "bash scripts/start.sh",
    "beta:setup": ".venv/bin/python scripts/beta.py setup",
    "beta:start": ".venv/bin/python scripts/beta.py start",
    "beta:stop": ".venv/bin/python scripts/beta.py stop",
    "beta:status": ".venv/bin/python scripts/beta.py status",
    "json:start": ".venv/bin/python scripts/beta.py start --storage json",
    "json:stop": ".venv/bin/python scripts/beta.py stop --storage json",
    "json:status": ".venv/bin/python scripts/beta.py status --storage json",
    "blob:start": ".venv/bin/python scripts/beta.py start --storage blob",
    "blob:stop": ".venv/bin/python scripts/beta.py stop --storage blob",
    "blob:status": ".venv/bin/python scripts/beta.py status --storage blob",
    "stop": "bash scripts/stop.sh",
    "status": ".venv/bin/python scripts/local.py status",
    "test": ".venv/bin/python -m pytest -q tests",
    "typecheck": "npm --prefix frontend run typecheck",
    "test:e2e": "node frontend/node_modules/@playwright/test/cli.js test",
    "audit": ".venv/bin/python scripts/audit-prices-costs.py",
    "check": "npm run test && npm run typecheck && npm run build",
    "docker:up": "bash scripts/docker.sh up",
    "docker:down": "bash scripts/docker.sh down"
  }
}
